# Fija los finales de linea para que git no muestre archivos enteros como
# "modificados" al abrirlos en equipos distintos.
# Guardados como LF en el repo, entregados como CRLF en Windows.
*.html text eol=crlf
*.md   text eol=crlf
*.json text eol=crlf
*.js   text eol=crlf
*.mjs  text eol=crlf

# Los archivos sin extension no los cubre ninguna regla de arriba y por eso
# aparecian como modificados sin haberlos tocado.
.gitignore     text eol=crlf
.gitattributes text eol=crlf
